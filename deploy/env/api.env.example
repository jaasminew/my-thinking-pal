HOST=127.0.0.1
PORT=8080
ACCOUNT_STORE=sqlite
ACCOUNT_DSN=file:/var/lib/thinking-pal/accounts.db?_journal=WAL
DOC_STORE=fs
DOC_PATH=/var/lib/thinking-pal/docs
PROJECT_MEMORY_PATH=/var/lib/thinking-pal
JWT_ACCESS_SECRET=__JWT_ACCESS_SECRET__
JWT_REFRESH_SECRET=__JWT_REFRESH_SECRET__
ACCESS_TTL=15m
REFRESH_TTL=720h
STT_PROVIDER=soniox
SONIOX_API_KEY=
SONIOX_MODEL=stt-rt-v5
TENCENT_APPID=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_ENGINE_MODEL=16k_zh
CORS_ORIGIN=https://__APP_DOMAIN__
TAVILY_API_KEY=
# Optional outbound proxy for Tavily (CN). Leave blank otherwise.
# HTTPS_PROXY=http://127.0.0.1:7890
