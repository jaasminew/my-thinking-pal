# Copy to .env and fill in only what you need.
#
# Current Unit 1 happy path:
# - SONIOX_API_KEY for streaming STT
# - GROQ_API_KEY for cleaned structured thinking notes
#
# Unit 2 can run visually without keys, but real AI/search backends need their
# corresponding credentials below.

# --- Tier-2 co-creation (Unit 2). THREE switchable backends, picked in the UI. ---

# 1) Claude Code — routes through your Claude *subscription* via the `claude` CLI
#    (no per-token API key). WebSearch is built in → it fills the inspiration cards.
#    One-time: run `claude setup-token`, paste the token here.
CLAUDE_CODE_OAUTH_TOKEN=

# 2) Codex — routes through your ChatGPT subscription via the local `codex` CLI.
#    One-time: run `./node_modules/.bin/codex login` (no key needed here).

# 3) Open + Tavily — an open model (Groq/Cerebras/Ollama, below) + Tavily web search.
#    Tavily returns clean snippets + images for the inspiration cards. https://tavily.com
TAVILY_API_KEY=

# Both CLIs hit foreign endpoints (Anthropic/OpenAI); in CN they need the proxy.
# They read HTTPS_PROXY (below); set AGENT_PROXY to override just for the CLIs.
AGENT_PROXY=

# --- Unit 1 cleanup / structured-notes LLM ---

# Local Ollama — no key, no proxy. Retained for experiments.
#   ollama pull qwen3:1.7b      (default)
#   ollama pull qwen3:4b        (a bit slower, better highlight quality)
# Qwen3's reasoning mode is auto-disabled server-side (/no_think) for latency.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:1.7b

# Groq — preferred hosted model provider for Unit 1. https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Cerebras — optional hosted model provider. https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama3.1-8b

# --- STT (the three picks: multilingual + low latency) ---

# 1. Soniox — real-time code-switching (中英混说). https://console.soniox.com
SONIOX_API_KEY=
SONIOX_MODEL=stt-rt-v5

# 2. Speechmatics — real-time bilingual streaming. https://portal.speechmatics.com
SPEECHMATICS_API_KEY=
SPEECHMATICS_RT_URL=wss://eu2.rt.speechmatics.com/v2
SPEECHMATICS_LANGUAGE=en

# 3. iFlytek 讯飞 RTASR — best Chinese + 中英混说, proxy-free in CN. https://www.xfyun.cn
IFLYTEK_APPID=
IFLYTEK_API_KEY=

# EXPERIMENTAL — Gemini Live adapter is retained in code, but not active in Unit 1 UI.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-2.0-flash-live-001

# (retained in code but unwired from the UI; not among the three picks)
DEEPGRAM_API_KEY=

# --- Proxy (CN) ---
# Needed ONLY for paid hosted APIs (Groq / Cerebras / Deepgram). Leave blank otherwise.
# Local Ollama and WebSpeech never use the proxy. Example: http://127.0.0.1:7890
HTTPS_PROXY=
