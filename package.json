{
  "name": "thinking-pal-canvas",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "sandbox": "vite-node sandbox/cocreate/run.ts --",
    "sandbox:web": "vite-node sandbox/cocreate/server.ts",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "dev:desktop": "VITE_DEV_SERVER_URL=http://localhost:5173 electron apps/desktop/main.cjs",
    "build:desktop": "VITE_API_URL=${VITE_API_URL:-https://mythinkingpal.xyz} npm run build && electron-builder --config apps/desktop/electron-builder.yml",
    "build:desktop:local": "npm run build && electron-builder --config apps/desktop/electron-builder.yml",
    "build:desktop:prod": "VITE_API_URL=https://mythinkingpal.xyz npm run build && electron-builder --config apps/desktop/electron-builder.yml"
  },
  "devDependencies": {
    "@openai/codex": "^0.142.4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "pdfjs-dist": "^6.1.200",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "undici": "^6.19.0",
    "y-indexeddb": "^9.0.12",
    "yjs": "^13.6.31"
  }
}
